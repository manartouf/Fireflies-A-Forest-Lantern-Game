<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Forest Lantern Game" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Forest Lantern Game" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Forest Lantern Game" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add directory="deps/freeglut/include" />
		</Compiler>
		<Linker>
			<Add option="-lfreeglut -lopengl32 -lglu32 -lwinmm -lgdi32" />
			<Add directory="deps/freeglut/lib/x64" />
		</Linker>
		<ExtraCommands>
			<Add after="cmd /c copy /Y &quot;$(PROJECT_DIR)deps\freeglut\bin\x64\libfreeglut.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot;" />
		</ExtraCommands>
		<Unit filename="main.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>